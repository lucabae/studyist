# iCloud (for calendar and mail)
ICLOUD_MAIL=
ICLOUD_APP_PASSWORD=
# Nombre exacto del calendario de iCloud donde se crean los eventos
ICLOUD_CALENDAR_NAME=Educación

# OpenRouter
OPENROUTER_API_KEY=

# Auth (JWT). Genera el valor con: openssl rand -hex 32
# Sin esto el backend no arranca el login (500 con mensaje claro).
JWT_SECRET=